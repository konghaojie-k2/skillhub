# My-Auth 环境变量配置
# 复制到你的项目根目录并重命名为 .env

# ========== JWT 配置（必填）==========
# 至少32字符的随机字符串
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-production-secret-key-min-32-characters

# ========== 数据库配置（可选）==========
# SQLite（默认）
DATABASE_URL=sqlite:///myauth.db

# PostgreSQL（生产环境推荐）
# DATABASE_URL=postgresql://postgres:password@localhost:5432/myauth

# ========== Redis 配置（可选）==========
# 用于 Token 黑名单（登出时失效）
# REDIS_URL=redis://localhost:6379

# ========== 管理员账户（可选）==========
# 首次启动时自动创建
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ========== 钉钉登录配置（可选）==========
# DINGTALK_ENABLED=false
# DINGTALK_APP_KEY=your-dingtalk-app-key
# DINGTALK_APP_SECRET=your-dingtalk-app-secret
# DINGTALK_REDIRECT_URI=http://localhost:3000/auth/dingtalk/callback
